#!/usr/bin/env bash
# grok-bot: bridge between Grok Bot and coding agents in herdr.
# Runs in the background (started by the herdr plugin) or in a herdr pane. Needs a running herdr server.
# Task:   $GROK_BOT_HUB/inbox/<id>.task   (hub defaults to ~/.grok-bot)
#   Line 1: agent=<name> kind=<cursor|claude|grok|pi|hermes|muse|...> cwd=<project path> [workspace=<id or label>]
#   Rest:   prompt (may be empty: just start the agent)
# Result: $GROK_BOT_HUB/outbox/<id>.md, then notify the webhook
# Config: herdr plugin config dir/webhook.env first, then $GROK_BOT_HUB/webhook.env.
set -u
HUB="${GROK_BOT_HUB:-$HOME/.grok-bot}"
mkdir -p "$HUB/inbox" "$HUB/outbox" "$HUB/done" "$HUB/failed"
herdr workspace list >/dev/null 2>&1 || { echo "grok-bot: herdr server is not running"; exit 1; }
# Single instance via a PID file in the hub.
PIDFILE="$HUB/bridge.pid"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  echo "grok-bot already running (pid $(cat "$PIDFILE"))"; exit 0
fi
echo $$ > "$PIDFILE"
cleanup(){ [ "$(cat "$PIDFILE" 2>/dev/null)" = $$ ] && rm -f "$PIDFILE"; kill $(jobs -p) 2>/dev/null; }
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
# Webhook config: herdr plugin config dir first, then the hub.
CFG_DIR="${HERDR_PLUGIN_CONFIG_DIR:-$(herdr plugin config-dir tracy-e.grok-bot 2>/dev/null || true)}"
WEBHOOK_ENV=""
for c in "${CFG_DIR:+$CFG_DIR/webhook.env}" "$HUB/webhook.env"; do [ -n "$c" ] && [ -f "$c" ] && { WEBHOOK_ENV="$c"; break; }; done
# shellcheck disable=SC1090
[ -n "$WEBHOOK_ENV" ] && . "$WEBHOOK_ENV"
log(){ echo "[$(date '+%H:%M:%S')] $*"; }
notify(){ # id agent state
  webhook_configured || return 0
  local headers=()
  [ -z "${GROK_WEBHOOK_KEY:-}" ] || headers=(-H "${GROK_WEBHOOK_HEADER:-Authorization}: ${GROK_WEBHOOK_PREFIX-Bearer }$GROK_WEBHOOK_KEY")
  curl -fsS -m 20 -X POST "$GROK_WEBHOOK_URL" \
    -H "Content-Type: application/json" \
    ${headers[@]+"${headers[@]}"} \
    -d "$(jq -n --arg id "$1" --arg agent "$2" --arg state "$3" --arg file "$HUB/outbox/$1.md" '{source:"grok-bot",id:$id,agent:$agent,state:$state,file:$file}')" >/dev/null \
    && log "$1: notified Grok Bot" || log "$1: webhook notification failed"
}
webhook_configured(){
  case "${GROK_WEBHOOK_URL:-}" in http://*|https://*) ;; *) return 1;; esac
  case "${GROK_WEBHOOK_URL:-}|${GROK_WEBHOOK_KEY:-}" in *example.invalid*|*your-webhook-key*) return 1;; esac
  return 0
}
field(){ sed -n "s/.*$1=\([^ ]*\).*/\1/p" <<<"$2"; }
agent_exists(){ herdr agent get "$1" >/dev/null 2>&1; }
# Workspace for a new agent tab: the task's workspace= (id or label), then the pane we run in,
# then the focused workspace, then the first one; create "agents" if none exist.
pick_ws(){
  local want="$1" list w
  list=$(herdr workspace list 2>/dev/null)
  if [ -n "$want" ]; then
    w=$(jq -r --arg x "$want" '.result.workspaces[]|select(.workspace_id==$x or .label==$x)|.workspace_id' <<<"$list" | head -1)
    [ -n "$w" ] && { echo "$w"; return; }
    return 1
  fi
  [ -n "${HERDR_WORKSPACE_ID:-}" ] && { echo "$HERDR_WORKSPACE_ID"; return; }
  w=$(jq -r '([.result.workspaces[]|select(.focused==true)] + .result.workspaces)[0].workspace_id // empty' <<<"$list")
  [ -n "$w" ] && { echo "$w"; return; }
  herdr workspace create --label agents --cwd "$HOME" --no-focus | jq -r '.result.workspace.workspace_id // .result.root_pane.workspace_id'
}

run_task(){
  local f="$1" id hdr name kind cwd prompt tab pane out st ws
  id=$(basename "$f" .task)
  mv "$f" "$HUB/inbox/$id.running" 2>/dev/null || return
  f="$HUB/inbox/$id.running"
  hdr=$(head -n1 "$f"); prompt=$(tail -n +2 "$f")
  name=$(field agent "$hdr"); kind=$(field kind "$hdr"); cwd=$(field cwd "$hdr"); cwd="${cwd/#\~/$HOME}"
  [ -n "$name" ] || { log "$id: missing agent="; mv "$f" "$HUB/failed/$id.task"; notify "$id" "" failed; return; }
  if ! agent_exists "$name"; then
    [ -n "$kind" ] || { log "$id: a new agent requires kind="; mv "$f" "$HUB/failed/$id.task"; notify "$id" "$name" failed; return; }
    log "$id: starting $name ($kind) in a new tab @ ${cwd:-$HOME}"
    ws=$(pick_ws "$(field workspace "$hdr")") || { log "$id: workspace not found"; mv "$f" "$HUB/failed/$id.task"; notify "$id" "$name" failed; return; }
    tab=$(herdr tab create --workspace "$ws" --cwd "${cwd:-$HOME}" --label "$name" --no-focus) || { mv "$f" "$HUB/failed/$id.task"; notify "$id" "$name" failed; return; }
    pane=$(jq -r '.result.root_pane.pane_id' <<<"$tab"); sleep 1
    herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout 120000 >/dev/null \
      || { log "$id: failed to start agent"; mv "$f" "$HUB/failed/$id.task"; notify "$id" "$name" failed; return; }
  fi
  if [ -n "$prompt" ]; then
    pane=$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.pane_id // empty')
    # Keep ownership until the watcher observes a settled state after this task exits.
    [ -z "$pane" ] || printf '%s\n' "$f" > "$HUB/watch.$pane.task"
    log "$id: sending prompt to $name"
    herdr agent prompt "$name" "$prompt" --wait --timeout 3600000 >/dev/null 2>&1
  fi
  st=$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.agent_status // "unknown"')
  out=$(herdr agent read "$name" --source recent-unwrapped --lines 200 2>&1)
  printf '# %s\nagent: %s\nstate: %s\n\n```\n%s\n```\n' "$id" "$name" "$st" "$out" > "$HUB/outbox/$id.md"
  mv "$f" "$HUB/done/$id.task"; log "$id: $st -> outbox/$id.md"; notify "$id" "$name" "$st"
}

# Watcher: report state changes of ANY herdr agent (not only ones this bridge started).
# Fires when an agent leaves "working" (finished, idle, or waiting for input). Disable with GROK_BOT_WATCH=0.
watch_agents(){
  local state="$HUB/watch.state" cur pane st prev title id agent h lt owned hash_cmd
  : > "$state" # A restart establishes a fresh baseline, not a completion event.
  hash_cmd=""
  for h in shasum sha1sum md5sum cksum; do
    if command -v "$h" >/dev/null 2>&1; then hash_cmd="$h"; break; fi
  done
  while true; do
    cur=$(herdr agent list 2>/dev/null | jq -r '.result.agents[]? | "\(.pane_id)\t\(.agent_status)\t\(.agent)\t\(.terminal_title_stripped // "")"') || { sleep 15; continue; }
    while IFS=$'\t' read -r pane st agent title; do
      [ -n "$pane" ] || continue
      prev=$(awk -F'\t' -v p="$pane" '$1==p{print $2}' "$state")
      owned="$HUB/watch.$pane.task"
      if [ -s "$owned" ]; then
        if [ "$st" != working ] && [ ! -f "$(cat "$owned")" ]; then : > "$owned"; fi
        continue
      fi
      if [ "$prev" = working ] && [ "$st" != working ]; then
        # Dedupe: agents waiting on a question can flap working<->done; skip if the screen hasn't changed.
        h=""
        if [ -n "$hash_cmd" ]; then
          h=$(herdr pane read "$pane" --lines 40 2>/dev/null | grep -v -E '⠁|⠂|⠄|⡀|⢀|⠠|⠐|⠈|⠰|Running|tokens' | "$hash_cmd" 2>/dev/null) || h=""
        fi
        if [ -n "$h" ] && [ "$h" = "$(cat "$HUB/watch.$pane.last" 2>/dev/null)" ]; then continue; fi
        # Cooldown: at most one report per pane every ${GROK_BOT_WATCH_COOLDOWN:-600}s (agents re-render while waiting).
        lt=$(stat -c %Y "$HUB/watch.$pane.last" 2>/dev/null) || lt=$(stat -f %m "$HUB/watch.$pane.last" 2>/dev/null) || lt=0
        case "$lt" in ''|*[!0-9]*) lt=0;; esac
        if [ $(( $(date +%s) - lt )) -lt "${GROK_BOT_WATCH_COOLDOWN:-600}" ]; then continue; fi
        echo "$h" > "$HUB/watch.$pane.last"
        id="watch-${pane//[:\/]/_}-$(date +%Y%m%d%H%M%S)"
        { printf '# %s\nagent: %s (%s)\npane: %s\nstate: %s -> %s\n\n```\n' "$id" "$agent" "$title" "$pane" "$prev" "$st"
          herdr pane read "$pane" --lines 60 2>&1; printf '```\n'; } > "$HUB/outbox/$id.md"
        log "watch: $title [$pane] $prev -> $st"; notify "$id" "$agent:$title" "$st"
      fi
    done <<<"$cur"
    printf '%s\n' "$cur" > "$state"
    sleep 15
  done
}

# Interrupted tasks may have sent their prompts already; fail them rather than replaying.
for f in "$HUB"/inbox/*.running; do
  [ -e "$f" ] || continue
  log "interrupted task: $(basename "$f") -> failed"
  mv "$f" "$HUB/failed/$(basename "$f" .running).task"
done
log "grok-bot started, watching $HUB/inbox"
if webhook_configured; then log "webhook config: $WEBHOOK_ENV"
else log "no webhook configured: results are written to outbox but Grok Bot will not be notified."; log "run: herdr plugin action invoke tracy-e.grok-bot.configure  (or bash plugin/configure.sh)"; fi
if [ "${GROK_BOT_WATCH:-1}" != 0 ]; then watch_agents & log "watching all herdr agents for state changes"; fi
while true; do
  for f in "$HUB"/inbox/*.task; do [ -e "$f" ] && run_task "$f" & done
  sleep 3
  # Exit with the herdr server so no orphan bridge is left behind.
  if herdr workspace list >/dev/null 2>&1; then miss=0; else miss=$((${miss:-0}+1)); fi
  [ "${miss:-0}" -ge 5 ] && { log "herdr server is gone, exiting"; exit 0; }
done
