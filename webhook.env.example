# Copy to ~/ai-hub/webhook.env (install.sh does this) and fill in from your Grok Bot routine.
GROK_WEBHOOK_URL="https://example.invalid/your-routine-webhook-url"
GROK_WEBHOOK_KEY="your-webhook-key"
# Optional: header name and value prefix (defaults: Authorization / "Bearer ")
# GROK_WEBHOOK_HEADER="Authorization"
# GROK_WEBHOOK_PREFIX="Bearer "
